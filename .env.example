# ==========================================
# PROVI SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==========================================

# Django Core
DJANGO_SECRET_KEY=your-production-secret-key-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=provi_sms_db
DB_USER=provi_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Timezone & Localization
TIME_ZONE=Africa/Lagos
LANGUAGE_CODE=en-us

# Security (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
